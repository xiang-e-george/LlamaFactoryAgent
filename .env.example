LFA_DOCKER_IMAGE=2f51fed82caa
# 替换为远端 Docker Engine 地址；真实地址请只写入本地 .env。
LFA_DOCKER_CONTEXT=tcp://127.0.0.1:2375
LFA_STORAGE_ROOT=/tmp/llamafactory-agent
LFA_RUNTIME_DIR=.runtime
LFA_API_HOST=127.0.0.1
LFA_API_PORT=8765
# 可选：逗号分隔的远端已有模型目录，只读扫描。
LFA_MODEL_SCAN_DIRS=
# 登记文件只能来自这些远端目录；不支持在线数据集仓库。
LFA_DATASET_SOURCE_DIRS=/opt/LlamaFactory/data
LFA_MAX_UPLOAD_BYTES=268435456
# 终态任务归档和容器回收的对账间隔，单位秒。
LFA_CLEANUP_INTERVAL=30
# 失败容器默认归档成功后立即回收；如需排查可改为 24，从任务结束时间起保留 24 小时。
LFA_FAILED_CONTAINER_RETENTION_HOURS=0
